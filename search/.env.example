# Copy to .env in this directory (search/, the bakeoff root). Every runner (bench via runs/*.sh, aa-stirrup/aa)
# sources this file with `set -a` and never prints a value. Offline tests need none of these.
#
# Answer and judge models. All published runs served the OpenAI models through OpenRouter
# (BAKEOFF_LLM_TRANSPORT=openrouter, set by the run scripts). Leave OPENAI_API_KEY unset: the scripts unset it so
# nothing falls back to a direct OpenAI call by accident.
OPENROUTER_API_KEY=

# Search providers under test. Set the ones you intend to run; `bench run --dry-run` reports what is missing.
EXA_API_KEY=
PERPLEXITY_API_KEY=
PARALLEL_API_KEY=
FIRECRAWL_API_KEY=
DEEPSEEK_API_KEY=
# Comparators from the upstream catalog. Tavily advanced search: 2 credits per request at
# $0.008 per credit pay-as-you-go = $16 per 1,000 searches (tavily.com/pricing, docs.tavily.com/documentation/api-credits,
# 2026-10-27; the adapter uses the credits each response reports). Brave LLM Context: Search plan, $5 per 1,000
# requests (brave.com/search/api, 2026-10-27). The harness accepts BRAVE_SEARCH_API_KEY or BRAVE_API_KEY.
TAVILY_API_KEY=
BRAVE_API_KEY=
EXPAND_API_KEY=
# Expand Search endpoint (POST /v1/search).
EXPAND_SEARCH_BASE_URL=https://api.expand.ai

# Hugging Face token. Optional: google/frames-benchmark, google/simpleqa-verified, vtllms/sealqa and
# ArtificialAnalysis/AA-Omniscience-Public are public and download without a token (`make download`); a token only
# raises the Hub's anonymous rate limits.
HF_TOKEN=
